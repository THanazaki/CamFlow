{
  "name": "camflow",
  "version": "0.1.0",
  "private": true,
  "description": "個人カメラマン向け撮影管理 PWA",
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:sw",
    "build:sw": "serwist build serwist.config.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:schema": "node supabase/tests/schema.test.mjs",
    "docs:tables": "node supabase/tools/gen-table-spec.mjs",
    "db:types": "supabase gen types typescript --local > src/types/database.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^1.1.7",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@serwist/cli": "^9.5.13",
    "@serwist/next": "^9.2.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "fake-indexeddb": "^6.2.2",
    "serwist": "^9.2.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
