# CamFlow の環境変数。`.env.local` にコピーして使う（.env.local は .gitignore 済み）

# ── Supabase 接続先 ────────────────────────────────────────────────
# ローカルスタック（ホスト側で `supabase start` したときの既定値）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# devcontainer の中からホスト側の Supabase に繋ぐ場合は 127.0.0.1 では届かない。
# コンテナからホストを指す名前に差し替える:
#   NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
# 疎通確認: curl -s -o /dev/null -w '%{http_code}\n' http://host.docker.internal:54321/rest/v1/

# クラウドの開発用プロジェクトを使う場合は上を差し替える
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# 開発中は Supabase を設定しなくても test / test でサインインできる。
# その場合データはこの端末にのみ残り、同期はされない（本番ビルドでは無効）。

# ── reCAPTCHA（ログイン画面の保護） ────────────────────────────────
# https://www.google.com/recaptcha/admin で v3 のキーを作る
# サイトキーはクライアントに出るので NEXT_PUBLIC_、秘密鍵はサーバ専用
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# v3 のスコアしきい値（省略時 0.5）。低いほど通りやすい
# RECAPTCHA_SCORE_THRESHOLD=0.5
#
# 未設定のときの挙動:
#   開発(NODE_ENV!=production) … 検証をスキップして警告を出す
#   本番                        … サインイン／新規登録を拒否する
#
# 注意: この reCAPTCHA は /api/auth 経由のログインフォームだけを守る。
# Supabase の認証エンドポイント自体は anon キーで直接叩けるため守れない。
# Supabase 側で強制したい場合は、対応している hCaptcha か Cloudflare Turnstile
# に替える必要がある（Supabase Auth は reCAPTCHA に非対応）。
