# CamFlow の環境変数。`.env.local` にコピーして使う（.env.local は .gitignore 済み）

# ── Supabase 接続先 ────────────────────────────────────────────────
# ローカルスタック（ホスト側で `supabase start` したときの既定値）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# devcontainer の中からホスト側の Supabase に繋ぐ場合は 127.0.0.1 では届かない。
# コンテナからホストを指す名前に差し替える:
#   NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
# 疎通確認: curl -s -o /dev/null -w '%{http_code}\n' http://host.docker.internal:54321/rest/v1/

# クラウドの開発用プロジェクトを使う場合は上を差し替える
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# ── 開発用アカウント ──────────────────────────────────────────────
# ログイン画面はまだ作っていないため、起動時にこのアカウントで自動サインインする。
# `supabase db reset` の seed が作るテストユーザー。
# ログイン画面を足すときは src/lib/auth/session.ts の signIn() だけ差し替えればよい。
NEXT_PUBLIC_DEV_USER_EMAIL=photographer@example.com
NEXT_PUBLIC_DEV_USER_PASSWORD=password123
